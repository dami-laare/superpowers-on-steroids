#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package BASE HEAD [OUTFILE] [-- PATH...]
# PATHs (after --) restrict the package to those pathspecs. Use this in
# parallel waves: scope each task's package to its own files so
# wave-mates' interleaved commits stay out of the diff.
# Default OUTFILE: <repo-root>/.superpowers/sdd/review-<base7>..<head7>[-<pathhash>].diff
# (named per range and pathspec, so parallel wave tasks and re-reviews
# after fixes each get a distinct fresh file).
set -euo pipefail

paths=()
args=()
seen_dashdash=0
for a in "$@"; do
  if [ "$seen_dashdash" -eq 1 ]; then
    paths+=("$a")
  elif [ "$a" = "--" ]; then
    seen_dashdash=1
  else
    args+=("$a")
  fi
done

if [ ${#args[@]} -lt 2 ] || [ ${#args[@]} -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE] [-- PATH...]" >&2
  exit 2
fi
if [ "$seen_dashdash" -eq 1 ] && [ ${#paths[@]} -eq 0 ]; then
  echo "error: '--' given but no paths follow" >&2
  exit 2
fi

base=${args[0]}
head=${args[1]}

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ ${#args[@]} -eq 3 ]; then
  out=${args[2]}
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  suffix=""
  if [ ${#paths[@]} -gt 0 ]; then
    suffix="-$(printf '%s\n' "${paths[@]}" | cksum | awk '{print $1}')"
  fi
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head")${suffix}.diff"
fi

pathspec=()
if [ ${#paths[@]} -gt 0 ]; then
  pathspec=(-- "${paths[@]}")
fi

{
  echo "# Review package: ${base}..${head}"
  if [ ${#paths[@]} -gt 0 ]; then
    echo "# Scoped to: ${paths[*]}"
  fi
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}" ${pathspec[@]+"${pathspec[@]}"}
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}" ${pathspec[@]+"${pathspec[@]}"}
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}" ${pathspec[@]+"${pathspec[@]}"}
} > "$out"

commits=$(git rev-list --count "${base}..${head}" ${pathspec[@]+"${pathspec[@]}"})
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
